<?xml version="1.0"?>
<!--
  UR5 tooling (zadatak 1): tool0 -> Robotiq FT300S -> Robotiq 3-Finger + TCP vrha prsta.

  Lanac (z-os tool0 prema van), bez spojnog elementa (na stvarnom robotu ga nema):
    tool0
      ft300_mounting_plate   spojnica FT300S na prirubnicu UR5, z = 0
      ft300_sensor           senzor; okvir je na izlaznoj plohi z = 0.0415 m, zakrenut za pi oko y
      ft300_tool_flange      izlazna ploha senzora, orijentirana kao tool0 (poništava zakret pi)
        robotiq_3f_frame     okvir šake: 12.7 mm ispred izlazne plohe (debljina AGS_wrist),
                             ista rpy kao u originalnoj montaži šake iz uputa
          finger_tip         TCP: jastučić distalnog članka prsta A
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotiq_3f_description)/urdf/robotiq_3f.xacro"/>
  <xacro:include filename="$(find robotiq_ft300s_description)/urdf/robotiq_ft300s.xacro"/>

  <xacro:macro name="ur5_workcell_tooling"
               params="tool0 prefix:='' include_cable_plugs:=true articulated_gripper:=true gripper_joint_damping:=1.0 gripper_joint_friction:=0.1">

    <!-- 1) Senzor sile i momenta izravno na tool0 -->
    <xacro:robotiq_ft300s parent="${tool0}" prefix="${prefix}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:robotiq_ft300s>

    <!-- 2) Izlazna ploha senzora s orijentacijom tool0 (ft300_sensor je zakrenut za pi oko y) -->
    <link name="${prefix}ft300_tool_flange"/>
    <joint name="${prefix}ft300_tool_flange_joint" type="fixed">
      <parent link="${prefix}ft300_sensor"/>
      <child link="${prefix}ft300_tool_flange"/>
      <origin xyz="0 0 0" rpy="0 ${pi} 0"/>
    </joint>

    <!-- 3) Šaka na izlaznu plohu senzora: ista montaža kao u uputama, samo je roditelj senzor -->
    <xacro:robotiq_3f_gripper parent="${prefix}ft300_tool_flange" prefix="${prefix}"
      include_cable_plugs="${include_cable_plugs}" articulated="${articulated_gripper}"
      joint_damping="${gripper_joint_damping}" joint_friction="${gripper_joint_friction}">
      <origin xyz="0 0 0.0127" rpy="1.5707963267948966 0 -0.7853981633974483"/>
    </xacro:robotiq_3f_gripper>

    <!--
      4) TCP za dodir s vratima: sredina jastučića distalnog članka prsta A (otvoreni prsti).
         Zadan u okviru robotiq_3f_frame:
           x_TCP = smjer prsta (+y šake), z_TCP = vanjska normala jastučića (-x šake), y_TCP = -z šake
           R = [[0,0,-1],[1,0,0],[0,-1,0]]  ->  rpy = (-pi/2, 0, pi/2)
         Rezultat: ^tool0 T_finger_tip, p = (0.0556, -0.0556, 0.2442) m.
         Ravni dio jastučića: x_TCP od -0.026 do +0.016 m; iza toga medijalni članak izlazi
         ~2 cm iznad ravnine jastučića - zato rub krila mora biti unutar ~2 cm od TCP-a.
    -->
    <link name="${prefix}finger_tip"/>
    <joint name="${prefix}finger_tip_joint" type="fixed">
      <parent link="${prefix}robotiq_3f_frame"/>
      <child link="${prefix}finger_tip"/>
      <origin xyz="0.0786 0.19 0.0" rpy="-1.5707963267948966 0 1.5707963267948966"/>
    </joint>
  </xacro:macro>
</robot>
